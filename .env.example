# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: secret key (sb_secret_…) or legacy service_role key. Never expose.
SUPABASE_SECRET_KEY=

# Groq (console.groq.com → API Keys)
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-20b. See console.groq.com/docs/models
GROQ_MODEL=

# Resend. Without a verified domain, CONTACT_TO_EMAIL must be your Resend account email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site origin used for canonical URLs, sitemap, structured data and llms.txt.
# Defaults to https://buildwithismail.xyz
NEXT_PUBLIC_SITE_URL=
